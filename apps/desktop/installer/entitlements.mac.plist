<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- CPython extension modules (ctypes, cffi) map writable+executable memory -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Plugins install third-party wheels into the data dir at runtime; their
       native modules are not signed by this team. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Voice input and the wake word -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- camera.snap on the local node -->
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
