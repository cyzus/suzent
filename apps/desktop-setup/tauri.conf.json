{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Suzent Setup",
  "version": "0.1.0",
  "identifier": "com.suzent.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Suzent Setup",
        "width": 760,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
